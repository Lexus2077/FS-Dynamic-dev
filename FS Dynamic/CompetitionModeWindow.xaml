<Window x:Class="FS_Dynamic.CompetitionModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Режим соревнований" Height="420" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF3A3A3A">
    <Border Margin="16" Padding="20" CornerRadius="12" Background="#FF2D2D2D">
        <StackPanel>
            <TextBlock Text="Выберите режим работы" FontSize="18" FontWeight="SemiBold"
                       Foreground="White" Margin="0,0,0,16" TextAlignment="Center"/>
            <TextBlock Text="После выбора откроется окно таймера с нужными полями (COM-порт, замер, сохранение)."
                       Foreground="#FFCCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Button x:Name="BtnLocal" Content="Локальный режим (файлы Teams.txt / Rounds.txt)"
                    Margin="0,4" Padding="12,10" FontSize="13" Click="BtnLocal_Click"
                    Background="#FF4A4A4A" Foreground="White" BorderBrush="#FF666666"/>

            <Button x:Name="BtnJocker" Content="Рулетка (Joker) — API"
                    Margin="0,4" Padding="12,10" FontSize="13" Click="BtnJocker_Click"
                    Background="#FF006666" Foreground="White" BorderBrush="#FF008888"/>

            <Button x:Name="BtnQual" Content="Квалификация — API"
                    Margin="0,4" Padding="12,10" FontSize="13" Click="BtnQual_Click"
                    Background="#FF006666" Foreground="White" BorderBrush="#FF008888"/>

            <Button x:Name="BtnBracket" Content="Турнирная сетка — API"
                    Margin="0,4" Padding="12,10" FontSize="13" Click="BtnBracket_Click"
                    Background="#FF006666" Foreground="White" BorderBrush="#FF008888"/>

            <Button Content="Отмена" Margin="0,20,0,0" Padding="12,8" Click="BtnCancel_Click"
                    Background="#FF555555" Foreground="White" BorderBrush="#FF777777"/>
        </StackPanel>
    </Border>
</Window>
