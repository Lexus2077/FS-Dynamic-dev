<Window x:Class="FS_Dynamic.BracketTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="FS Dynamic — турнирная сетка" Height="680" Width="920" Icon="/FS_Logo.jpg" Topmost="True" Background="#FF4C4343">
    <Grid>
        <Button x:Name="BtnChangeCompetitionMode" Content="Сменить режим"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0"
                Padding="12,6" Background="#FF555555" Foreground="White" BorderBrush="#FF777777"
                Click="ChangeCompetitionMode_Click"
                ToolTip="Локальный / Joker / квалификация / турнирная сетка"/>
        <Border Height="560" Width="760" Margin="15" Padding="30" VerticalAlignment="Stretch" CornerRadius="50">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF009999" Offset="0.2"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="LightGray" ShadowDepth="0" />
            </Border.Effect>

            <Grid Margin="0,0,89,32">
                <Button x:Name="On" Content="Yellow" Margin="272,57,233,219" Foreground="#DDFDFF06" Background="#FF373240" Width="75" Height="32" Click="Yellow"/>
                <Button x:Name="Off" Content="White" HorizontalAlignment="Left" Margin="392,137,0,0" VerticalAlignment="Top" Width="76" Background="#FF373240" Height="32" Click="White"/>
                <ComboBox x:Name="COM" HorizontalAlignment="Left" Margin="0,47,0,0" VerticalAlignment="Top" Width="98" SelectionChanged="COM_SelectionChanged" Height="22"/>
                <ComboBox x:Name="cboBracketCompetitions" Margin="114,44,357,0" VerticalAlignment="Top"
                          DisplayMemberPath="name" SelectedValuePath="id"
                          SelectionChanged="CboBracketCompetitions_SelectionChanged"/>
                <ComboBox x:Name="cboBracketDisciplines" Margin="273,44,198,0" VerticalAlignment="Top"
                          DisplayMemberPath="display_name" SelectedValuePath="discipline"
                          SelectionChanged="CboBracketDisciplines_SelectionChanged"/>
                <Button x:Name="btnBracketRefresh" Content="Обновить" Margin="500,-86,165,0" VerticalAlignment="Top"
                        Width="70" Height="22" Click="BtnBracketRefresh_Click"
                        Background="#FF373240" Foreground="#DDFDFDFC"/>
                <ComboBox x:Name="cboBracketMatches" Margin="430,44,-104,0" Width="285" VerticalAlignment="Top"
                          DisplayMemberPath="display"
                          SelectionChanged="CboBracketMatches_SelectionChanged"/>
                <TextBlock x:Name="TextIn" HorizontalAlignment="Left" Margin="0,-6,0,0" TextWrapping="Wrap" Text="Status" VerticalAlignment="Top" Height="33" Width="84" Foreground="White" FontSize="20" TextAlignment="Center">
                    <TextBlock.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="#FF373240"/>
                        </LinearGradientBrush>
                    </TextBlock.Background>
                </TextBlock>
                <TextBlock x:Name="Result" HorizontalAlignment="Left" Margin="82,153,0,262" TextWrapping="Wrap" Width="196" Foreground="#FFDCDBDB" FontSize="20" TextAlignment="Center" Text="00:000&#xA;" FontWeight="Bold" Height="53"/>
                <Label Margin="47,153,445,129" Content="Clear Time:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <TextBlock x:Name="Bust_Q" HorizontalAlignment="Left" Margin="130,192,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="36" FontSize="20" Text="0" TextAlignment="Center" Foreground="#FFDCDBDB"/>
                <TextBlock x:Name="Skip_Q" HorizontalAlignment="Left" Margin="130,234,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="36" FontSize="20" Text="0" TextAlignment="Center" Foreground="#FFDCDBDB"/>
                <Label Margin="47,192,445,90" Content="Busts:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <Label Margin="47,236,445,46" Content="Skips:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <TextBlock x:Name="Result_plus_Busts" HorizontalAlignment="Left" Margin="82,278,0,0" TextWrapping="Wrap" Text="00:000" VerticalAlignment="Top" Width="196" Height="53" Foreground="#FFDCDBDB" FontSize="20" TextAlignment="Center" FontWeight="Bold"/>
                <Label Margin="47,277,445,5" Content="Final Time:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <Button x:Name="Result_Time" Content="Final" Margin="288,276,248,160" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Result_Time_Click" Width="75"/>
                <Button x:Name="Show_Demo" Content="Demo" Margin="616,137,-80,299" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Open_Demo" Width="75"/>
                <Button x:Name="Stop_Round" Content="End" Margin="490,57,26,219" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Stop_Round_Click" Width="75"/>
                <Button x:Name="Bust" Content="Bust +" Margin="288,188,248,248" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Bust_Click" Width="75" BorderBrush="#FFF90B00"/>
                <Button x:Name="Skip_plus" Content="Skip +" Margin="288,230,248,206" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Skip_plus_Click" Width="75" BorderBrush="#FFF90B00"/>
                <Button x:Name="Skip_min" Content="Skip -" Margin="392,230,143,206" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Skip_min_Click" Width="75"/>
                <Button x:Name="Bust_min" Content="Bust -" Margin="392,188,143,248" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Bust_min_Click" Width="75"/>
                <TextBlock x:Name="lblBracketNoMatches" Margin="54,307,-5,0" VerticalAlignment="Top"
                           Foreground="#FFE0E080" FontSize="12" TextWrapping="Wrap"
                           Text="Нет доступных матчей и записей распределения мест." Visibility="Collapsed"/>
                <TextBlock x:Name="lblBracketTeam1Result" Margin="50,344,286,0" VerticalAlignment="Top"
                           Foreground="#E5FFFCFC" FontSize="12" TextWrapping="Wrap" Height="67"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="lblBracketTeam2Result" Margin="325,344,0,0" VerticalAlignment="Top"
                           Foreground="#E5FFFCFC" FontSize="12" TextWrapping="Wrap" Height="67"
                           Visibility="Collapsed"/>
                <!-- Подписи «Ввод для команды #…» выставляются в коде при выборе матча (ApplyBracketSlotRadioLabels). -->
                <RadioButton x:Name="rdoBracketSlot1" Content="Ввод для команды 1" GroupName="BracketSlotGroup"
                             Margin="50,315,367,0" VerticalAlignment="Top" Foreground="#E5FFFCFC"
                             Visibility="Collapsed" Checked="RdoBracketSlot_Checked"/>
                <RadioButton x:Name="rdoBracketSlot2" Content="Ввод для команды 2" GroupName="BracketSlotGroup"
                             Margin="244,315,198,0" VerticalAlignment="Top" Foreground="#E5FFFCFC"
                             Visibility="Collapsed" Checked="RdoBracketSlot_Checked"/>
                <Button x:Name="Red_Signal" Content="Signal" Margin="606,277,-90,-1" Foreground="#DDFDFDFC" Background="#FFCA2E26" Height="32" Click="Red_Signal_Click" Width="75"/>
                <Button x:Name="Lines" Content="Lines" Margin="606,227,-90,49" Foreground="#DDFDFDFC" Background="#FF22D20A" Height="32" Click="Lines_ON_Click" Width="75"/>
            </Grid>
        </Border>
    </Grid>
</Window>
