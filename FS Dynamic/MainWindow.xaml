<Window x:Class="FS_Dynamic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FS_Dynamic"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MainWindow" Height="620" Width="900" Icon="/FS_Logo.jpg" Topmost="True" Background="#FF4C4343">
    
    <Grid Cursor="">
        <Border Height="400" Width="740" Margin="15" Padding="30" VerticalAlignment="Stretch" CornerRadius="50" Cursor="">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF009999" Offset="0.2"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="LightGray" ShadowDepth="0" />
            </Border.Effect>

            <Grid Margin="0,0,89,32">


                <Button x:Name="On" Content="Yellow" Margin="272,57,233,219" Foreground="#DDFDFF06" Background="#FF373240" Width="75" Height="32" Click="Yellow"/>
                <Button x:Name="Off" Content="White" HorizontalAlignment="Left" Margin="382,57,0,0" VerticalAlignment="Top" Width="75" RenderTransformOrigin="0.4,-1.156" Background="#FF373240" Grid.Column="1" Height="32" Click="White"/>
                <ComboBox x:Name="COM" HorizontalAlignment="Left" Margin="25,-56,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="COM_SelectionChanged" Height="22" Background="#00000000" Grid.ColumnSpan="2"/>
                <ComboBox x:Name= "Team_Name" HorizontalAlignment="Left" Margin="208,-56,0,0" VerticalAlignment="Top" Width="120" Loaded="Team_Name_Loaded" Height="22"/>
                <ComboBox x:Name="Rounds" HorizontalAlignment="Left" Margin="360,-56,0,0" VerticalAlignment="Top" Width="120" Height="22" RenderTransformOrigin="0.451,0.756" Loaded="Rounds_Loaded"/>
                <TextBlock x:Name="TextIn" HorizontalAlignment="Left" Margin="26,0,0,0" TextWrapping="Wrap" Text="Status" VerticalAlignment="Top" Height="33" Width="84" Foreground="White" FontSize="20" TextAlignment="Center" RenderTransformOrigin="0.512,-0.939" Grid.ColumnSpan="2">
                    <TextBlock.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="#FF373240"/>
                        </LinearGradientBrush>
                    </TextBlock.Background>
                </TextBlock>
                <TextBlock x:Name="Result" HorizontalAlignment="Left" Margin="100,109,0,163" TextWrapping="Wrap" Width="196" OpacityMask="#FFF9F9F9" Foreground="#FFDCDBDB" FontSize="20" TextAlignment="Center" Text="00:000&#xA;" FontWeight="Bold" Height="53"/>
                <Label Margin="61,109,431,173" Content="Clear Time:" FontSize="16" RenderTransformOrigin="0.414,0.155" FontWeight="Bold" Foreground="#E5FFFCFC" Grid.ColumnSpan="2"/>
                <TextBlock x:Name= "Bust_Q" HorizontalAlignment="Left" Margin="160,140,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="36" FontSize="20" Text="0" TextAlignment="Center" Foreground="#FFDCDBDB"/>
                <TextBlock x:Name= "Skip_Q" HorizontalAlignment="Left" Margin="160,181,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="36" FontSize="20" Text="0" TextAlignment="Center" Foreground="#FFDCDBDB"/>
                <Label Margin="68,150,424,132" Content="Busts:" FontSize="16" RenderTransformOrigin="0.414,0.155" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <Label Margin="68,191,424,91" Content="Skips:" FontSize="16" RenderTransformOrigin="0.414,0.155" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <TextBlock x:Name="Result_plus_Busts" HorizontalAlignment="Left" Margin="100,233,0,0" TextWrapping="Wrap" Text="00:000" VerticalAlignment="Top" Width="196" Height="53" OpacityMask="#FFF9F9F9" Foreground="#FFDCDBDB" FontSize="20" TextAlignment="Center" FontWeight="Bold"/>
                <Label Margin="61,233,431,49" Content="Final Time:" FontSize="16" RenderTransformOrigin="0.414,0.155" FontWeight="Bold" Foreground="#E5FFFCFC"/>

                <Button x:Name="Result_Time" Content="Final" Margin="278,228,239,48" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Result_Time_Click" Width="75"/>
                <Button x:Name="Show_Demo" Content="Demo" Margin="606,1,-90,275" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Open_Demo" Width="75"/>
                <Button x:Name="Stop_Round" Content="End" Margin="490,57,26,219" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Stop_Round_Click" Width="75"/>
                <Button x:Name="Bust" Content="Bust +" Margin="278,128,238,148" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Bust_Click" Width="75" BorderBrush="#FFF90B00"/>
                <Button x:Name="Skip_plus" Content="Skip +" Margin="278,182,238,94" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Skip_plus_Click" Width="75" BorderBrush="#FFF90B00"/>
                <Button x:Name="Skip_min" Content="Skip -" Margin="382,181,134,95" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Skip_min_Click" Width="75"/>
                <Button x:Name="Bust_min" Content="Bust -" Margin="382,128,133,148" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Bust_min_Click" Width="75" RenderTransformOrigin="0.447,3.782"/>
                <CheckBox x:Name="chkJockerMode" Content="Режим Рулетка (API)" 
              Margin="5,279,5,0" VerticalAlignment="Top"
              Checked="ChkJockerMode_Checked" Unchecked="ChkJockerMode_Unchecked"/>
                <CheckBox x:Name="chkQualMode" Content="Режим Квалификации (API)"
              Margin="5,302,5,0" VerticalAlignment="Top"
              Checked="ChkQualMode_Checked" Unchecked="ChkQualMode_Unchecked"/>
                <CheckBox x:Name="chkBracketMode" Content="Режим Сетки (API)"
              Margin="5,325,5,0" VerticalAlignment="Top"
              Checked="ChkBracketMode_Checked" Unchecked="ChkBracketMode_Unchecked"/>
                <TextBlock x:Name="lblExistingResult" Margin="8,348,8,0" VerticalAlignment="Top"
                           Foreground="#E5FFFCFC" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" MaxWidth="420"/>
                <TextBlock x:Name="lblBracketNoMatches" Margin="8,348,8,0" VerticalAlignment="Top"
                           Foreground="#FFE0E080" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" Text="Нет доступных speed-матчей для этой дисциплины."/>
                <TextBlock x:Name="lblBracketTeam1Result" Margin="16,378,0,0" VerticalAlignment="Top"
                           Foreground="#E5FFFCFC" FontSize="12" Width="380" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="lblBracketTeam2Result" Margin="400,378,16,0" VerticalAlignment="Top"
                           Foreground="#E5FFFCFC" FontSize="12" Width="400" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <RadioButton x:Name="rdoBracketSlot1" Content="Ввод для команды 1" GroupName="BracketSlotGroup"
                             Margin="24,408,0,0" VerticalAlignment="Top" Foreground="#E5FFFCFC"
                             Visibility="Collapsed" Checked="RdoBracketSlot_Checked"/>
                <RadioButton x:Name="rdoBracketSlot2" Content="Ввод для команды 2" GroupName="BracketSlotGroup"
                             Margin="240,408,0,0" VerticalAlignment="Top" Foreground="#E5FFFCFC"
                             Visibility="Collapsed" Checked="RdoBracketSlot_Checked"/>
                <ComboBox x:Name="cboJockerCompetitions" Margin="208,-86,263,0" ItemsSource="{Binding JockerCompetitions}" DisplayMemberPath="name" SelectedValuePath="id" SelectionChanged="CboJockerCompetitions_SelectionChanged" VerticalAlignment="Top"  Visibility="Collapsed"/>
                <ComboBox x:Name="cboJockerDisciplines" Margin="360,-86,111,0" ItemsSource="{Binding JockerDisciplines}" DisplayMemberPath="discipline_name" SelectedValuePath="discipline" SelectionChanged="CboJockerDisciplines_SelectionChanged" VerticalAlignment="Top"  Visibility="Collapsed"/>
                <ComboBox x:Name="cboJockerRounds" Width="120" Margin="509,-86,-38,0"
              ItemsSource="{Binding JockerRounds}"
              SelectedValuePath="round_number"
              SelectionChanged="CboJockerRounds_SelectionChanged" VerticalAlignment="Top"
               Visibility="Collapsed"
                >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                    <Run Text="Раунд "/>
                    <Run Text="{Binding round_number}"/>
                    <Run Text=" (" Foreground="Gray" FontSize="10"/>
                    <Run Text="{Binding team_count}" Foreground="Gray" FontSize="10"/>
                    <Run Text=")" Foreground="Gray" FontSize="10"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                 </ComboBox>
                <ComboBox x:Name="cboJockerTeams" Margin="644,-86,-177,0" ItemsSource="{Binding JockerTeams}" DisplayMemberPath="team_members_display" SelectedValuePath="jocker_team_id" SelectionChanged="CboJockerTeams_SelectionChanged" VerticalAlignment="Top"  Visibility="Collapsed"/>
                <ComboBox x:Name="cboQualCompetitions" Margin="208,-86,263,0" VerticalAlignment="Top"
                          DisplayMemberPath="name" SelectedValuePath="id"
                          SelectionChanged="CboQualCompetitions_SelectionChanged" Visibility="Collapsed"/>
                <ComboBox x:Name="cboQualDisciplines" Margin="360,-86,111,0" VerticalAlignment="Top"
                          DisplayMemberPath="display_name" SelectedValuePath="discipline"
                          SelectionChanged="CboQualDisciplines_SelectionChanged" Visibility="Collapsed"/>
                <ComboBox x:Name="cboQualRounds" Margin="509,-86,-38,0" Width="120" VerticalAlignment="Top"
                          DisplayMemberPath="display" SelectedValuePath="round_number"
                          SelectionChanged="CboQualRounds_SelectionChanged" Visibility="Collapsed"/>
                <ComboBox x:Name="cboQualTeams" Margin="644,-86,-177,0" VerticalAlignment="Top"
                          DisplayMemberPath="display" SelectedValuePath="id"
                          SelectionChanged="CboQualTeams_SelectionChanged" Visibility="Collapsed"/>
                <ComboBox x:Name="cboBracketCompetitions" Margin="208,-86,263,0" VerticalAlignment="Top"
                          DisplayMemberPath="name" SelectedValuePath="id"
                          SelectionChanged="CboBracketCompetitions_SelectionChanged" Visibility="Collapsed"/>
                <ComboBox x:Name="cboBracketDisciplines" Margin="360,-86,111,0" VerticalAlignment="Top"
                          DisplayMemberPath="display_name" SelectedValuePath="discipline"
                          SelectionChanged="CboBracketDisciplines_SelectionChanged" Visibility="Collapsed"/>
                <Button x:Name="btnBracketRefresh" Content="Обновить" Margin="500,-86,165,0" VerticalAlignment="Top"
                        Width="70" Height="22" Click="BtnBracketRefresh_Click" Visibility="Collapsed"
                        Background="#FF373240" Foreground="#DDFDFDFC"/>
                <ComboBox x:Name="cboBracketMatches" Margin="585,-86,-118,0" Width="285" VerticalAlignment="Top"
                          DisplayMemberPath="display"
                          SelectionChanged="CboBracketMatches_SelectionChanged" Visibility="Collapsed"/>
                <Button x:Name="Red_Signal" Content="Signal" Margin="606,277,-90,-1" Foreground="#DDFDFDFC" Background="#FFCA2E26" Height="32" Click="Red_Signal_Click" Width="75"/>
                <Button x:Name="Lines" Content="Lines" Margin="606,227,-90,49" Foreground="#DDFDFDFC" Background="#FF22D20A" Height="32" Click="Lines_ON_Click" Width="75"/>

            </Grid>
        </Border>

    </Grid>
    
</Window>
