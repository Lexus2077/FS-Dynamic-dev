<Window x:Class="FS_Dynamic.QualificationTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FS Dynamic — квалификация" Height="640" Width="900" Icon="/FS_Logo.jpg" Topmost="True" Background="#FF4C4343">
    <Grid>
        <Border Height="520" Width="740" Margin="115,87,45,17" Padding="30" CornerRadius="50">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF009999" Offset="0.2"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="LightGray" ShadowDepth="0" />
            </Border.Effect>

            <Grid Margin="0,0,89,32">
                <Button x:Name="On" Content="Yellow" Margin="272,57,233,219" Foreground="#DDFDFF06" Background="#FF373240" Width="75" Height="32" Click="Yellow"/>
                <Button x:Name="Off" Content="White" HorizontalAlignment="Left" Margin="382,117,0,0" VerticalAlignment="Top" Width="76" Background="#FF373240" Height="32" Click="White"/>
                <ComboBox x:Name="COM" HorizontalAlignment="Left" Margin="1,49,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="COM_SelectionChanged" Height="22" Background="#00000000"/>
                <ComboBox x:Name="cboQualCompetitions" Margin="138,46,333,0" VerticalAlignment="Top"
                          DisplayMemberPath="name" SelectedValuePath="id"
                          SelectionChanged="CboQualCompetitions_SelectionChanged"/>
                <ComboBox x:Name="cboQualDisciplines" Margin="278,46,193,0" VerticalAlignment="Top"
                          DisplayMemberPath="display_name" SelectedValuePath="discipline"
                          SelectionChanged="CboQualDisciplines_SelectionChanged"/>
                <ComboBox x:Name="cboQualRounds" Margin="420,46,51,0" Width="120" VerticalAlignment="Top"
                          DisplayMemberPath="display" SelectedValuePath="round_number"
                          SelectionChanged="CboQualRounds_SelectionChanged"/>
                <ComboBox x:Name="cboQualTeams" Margin="568,48,-101,0" VerticalAlignment="Top"
                          DisplayMemberPath="display" SelectedValuePath="id"
                          SelectionChanged="CboQualTeams_SelectionChanged"/>
                <TextBlock x:Name="TextIn" HorizontalAlignment="Left" Margin="1,0,0,0" TextWrapping="Wrap" Text="Status" VerticalAlignment="Top" Height="33" Width="84" Foreground="White" FontSize="20" TextAlignment="Center">
                    <TextBlock.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black" Offset="1"/>
                            <GradientStop Color="#FF373240"/>
                        </LinearGradientBrush>
                    </TextBlock.Background>
                </TextBlock>
                <TextBlock x:Name="Result" HorizontalAlignment="Left" Margin="100,154,0,221" TextWrapping="Wrap" Width="196" Foreground="#FFDCDBDB" FontSize="20" TextAlignment="Center" Text="00:000&#xA;" FontWeight="Bold" Height="53"/>
                <Label Margin="42,151,451,131" Content="Clear Time:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <TextBlock x:Name="Bust_Q" HorizontalAlignment="Left" Margin="147,192,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="36" FontSize="20" Text="0" TextAlignment="Center" Foreground="#FFDCDBDB"/>
                <TextBlock x:Name="Skip_Q" HorizontalAlignment="Left" Margin="148,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="50" Height="36" FontSize="20" Text="0" TextAlignment="Center" Foreground="#FFDCDBDB"/>
                <Label Margin="42,189,449,93" Content="Busts:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <Label Margin="42,230,449,52" Content="Skips:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <TextBlock x:Name="Result_plus_Busts" HorizontalAlignment="Left" Margin="100,274,0,0" TextWrapping="Wrap" Text="00:000" VerticalAlignment="Top" Width="196" Height="53" Foreground="#FFDCDBDB" FontSize="20" TextAlignment="Center" FontWeight="Bold"/>
                <Label Margin="42,272,451,10" Content="Final Time:" FontSize="16" FontWeight="Bold" Foreground="#E5FFFCFC"/>
                <Button x:Name="Result_Time" Content="Final" Margin="278,271,239,125" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Result_Time_Click" Width="75"/>
                <Button x:Name="Show_Demo" Content="Demo" Margin="606,117,-90,279" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Open_Demo" Width="75"/>
                <Button x:Name="Stop_Round" Content="End" Margin="490,57,26,219" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Stop_Round_Click" Width="75"/>
                <Button x:Name="Bust" Content="Bust +" Margin="278,128,238,148" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Bust_Click" Width="75" BorderBrush="#FFF90B00"/>
                <Button x:Name="Skip_plus" Content="Skip +" Margin="278,229,238,167" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Skip_plus_Click" Width="75" BorderBrush="#FFF90B00"/>
                <Button x:Name="Skip_min" Content="Skip -" Margin="382,229,133,167" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Skip_min_Click" Width="75"/>
                <Button x:Name="Bust_min" Content="Bust -" Margin="382,128,133,148" Foreground="#DDFDFDFC" Background="#FF373240" Height="32" Click="Bust_min_Click" Width="75"/>
                <TextBlock x:Name="lblExistingResult" Margin="8,272,8,0" VerticalAlignment="Top"
                           Foreground="#E5FFFCFC" FontSize="12" TextWrapping="Wrap" MaxWidth="420"/>
                <Button x:Name="Red_Signal" Content="Signal" Margin="606,277,-90,-1" Foreground="#DDFDFDFC" Background="#FFCA2E26" Height="32" Click="Red_Signal_Click" Width="75"/>
                <Button x:Name="Lines" Content="Lines" Margin="606,227,-90,49" Foreground="#DDFDFDFC" Background="#FF22D20A" Height="32" Click="Lines_ON_Click" Width="75"/>
            </Grid>
        </Border>
    </Grid>
</Window>
