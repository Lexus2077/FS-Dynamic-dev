# Скопируйте этот файл в .env и измените значения под нужный сервер.
# Файл .env кладётся рядом с FS Dynamic.exe (в папку bin/Debug или bin/Release).
# .env НЕ коммитится в git.

# ══════════════════════════════════════════════════════════════════
# ВАРИАНТ 1: fsdynamic.ru — проект живёт в /fs-dynamic-web/
#   WPF будет обращаться к:
#     http://fsdynamic.ru/fs-dynamic-web/api/auth.php
#     http://fsdynamic.ru/fs-dynamic-web/competitions/api/brackets.php  ...
# ══════════════════════════════════════════════════════════════════
API_BASE_URL=http://fsdynamic.ru


# ══════════════════════════════════════════════════════════════════
# ВАРИАНТ 2: competition-service.s1.effps.ru — тестовый сервер
#   Структура та же (/fs-dynamic-web/), меняем только домен:
# ══════════════════════════════════════════════════════════════════
# API_BASE_URL=http://competition-service.s1.effps.ru
